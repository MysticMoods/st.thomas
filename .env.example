# Parish dashboard bootstrap account.
# Copy this file to .env.local and change all three values before going live.
#
# This pair is only a way in until the first real account is made in the
# dashboard under People & access. The moment one exists, this login stops
# working and every change is recorded against the person who made it.

# User ID typed at /admin (case-insensitive)
ADMIN_USERNAME=vicar

# Password for that account. Invent nothing short: this one login can edit
# every page on the site.
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie. Generate one, do not invent it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Optional — machine translation endpoint used by the dashboard's
# English <-> Malayalam auto-fill. Leave unset to use the free public one.
# TRANSLATE_ENDPOINT=

# Razorpay — online giving. Leave both blank and the donation section falls back
# to the bank and UPI details from content/donation.json, with the checkout
# button switched off. Test keys start rzp_test_, live keys rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional but recommended once live. Create a webhook in the Razorpay dashboard
# pointing at https://<your-domain>/api/donate/webhook for the events
# payment.captured and payment.failed, and paste its secret here. It records a
# payment even when the donor closes the tab before the page can confirm it.
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------- storage
# Where the parish's words and photographs are kept.
#
# Leave both blank and the site uses its own disk, which is right for a machine
# the parish owns and for working on it locally. Set both and it uses Supabase
# instead, which is what a host with no disk of its own needs.
#
# Set them up together or not at all: half-configured, the site refuses to
# start rather than write half its records to one place and half to the other.
#
#   1. supabase.com, new project, region South Asia (Mumbai)
#   2. SQL Editor, run scripts/supabase-schema.sql
#   3. Storage, new bucket named "uploads", marked public
#   4. Project Settings, API — the URL and the secret (service_role) key
#
# The secret key can read and write everything and ignores every rule set on
# the database. It belongs on the server and nowhere else: never in a page,
# never in the repository, never pasted into a chat window.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------- letters out
# Without these the site still takes every message and booking, but nothing is
# delivered: no acknowledgement to the family, no notice to the office, no
# donation receipt, no newsletter. The dashboard says so plainly under
# "Letters sent" and every unsent letter is kept there.
#
# Any ordinary SMTP account will do — the parish's own mail host, Zoho, Google
# Workspace, or a service such as Brevo or Postmark.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
# Leave unset to follow the port: 465 speaks TLS at once, 587 upgrades to it.
# MAIL_SECURE=

# Who letters appear to come from. Use an address on your own domain, or mail
# from it will be treated as forged.
MAIL_FROM=St. Thomas Church <parish@your-domain.in>

# Where notices for the parish itself go — messages, hall requests. Defaults to
# MAIL_FROM when unset.
MAIL_OFFICE=

# Used for the links inside letters, including the unsubscribe link.
SITE_URL=https://your-domain.in

# --------------------------------------------------------------- form limits
# Per address, per hour. The defaults suit a parish; raise one only if a shared
# office connection trips over it.

# Contact form messages (default 5)
CONTACT_LIMIT=

# Newsletter sign-ups (default 5)
NEWSLETTER_LIMIT=

# Hall booking requests allowed from one address per hour (default 6)
HALL_BOOKING_LIMIT=

# Hall reviews allowed from one address per hour (default 6)
HALL_REVIEW_LIMIT=
