# Parish dashboard host account.
# Copy this file to .env.local and change all three values before going live.

# User ID typed at /admin (case-insensitive)
ADMIN_USERNAME=vicar

# Password for that account.
#
# Left blank on purpose. A password printed in a repository is not a password,
# and this file is in the repository. In development the code falls back to a
# demo one so a fresh clone runs; in production a blank here means there is no
# bootstrap login at all, which is the safe way round. Set your own before the
# site is reachable from outside.
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie — any long random string
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Optional — machine translation endpoint used by the dashboard's
# English <-> Malayalam auto-fill. Leave unset to use the free public one.
# TRANSLATE_ENDPOINT=

# Razorpay — online giving. Leave both blank and the donation section falls back
# to the bank and UPI details from content/donation.json, with the checkout
# button switched off. Test keys start rzp_test_, live keys rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional but recommended once live. Create a webhook in the Razorpay dashboard
# pointing at https://<your-domain>/api/donate/webhook for the events
# payment.captured and payment.failed, and paste its secret here. It records a
# payment even when the donor closes the tab before the page can confirm it.
RAZORPAY_WEBHOOK_SECRET=

# Hall booking requests allowed from one address per hour (default 6)
HALL_BOOKING_LIMIT=

# Hall reviews allowed from one address per hour (default 6)
HALL_REVIEW_LIMIT=

# ---------------------------------------------------------------- letters
# Without MAIL_HOST and MAIL_FROM the site still writes every letter down and
# the dashboard says plainly that none of it is being delivered — but nothing
# reaches anybody. Contact acknowledgements, hall confirmations, donation
# receipts, and the certificate "on its way" note all go through
# here, so this is the difference between a site that answers people and one
# that only files what they said.
#
# Any ordinary SMTP account works: the parish's own mailbox with its provider,
# or a sending service. Port 587 with STARTTLS is the usual answer; 465 is
# implicit TLS and switches MAIL_SECURE on by itself.
MAIL_HOST=
MAIL_PORT=587
# true for port 465. Left blank it follows the port.
MAIL_SECURE=
MAIL_USER=
MAIL_PASS=
# The address letters come from — "St. Thomas Church <office@example.org>".
MAIL_FROM=
# Where the office's own copy of a form goes, if not MAIL_FROM.
MAIL_OFFICE=

# The site's own address, used for the links inside letters — the unsubscribe
# link most of all. Wrong here means a link that goes nowhere.
SITE_URL=

# ------------------------------------------------------------ where it writes
# Blank uses the parish's own disk, which is what a box you own should do and
# what a fresh clone needs. Set both SUPABASE values to keep content, uploads
# and records in Supabase instead — for a host with no disk to write to.
# STORAGE=disk forces the disk even when they are set, which is what you want
# while working on the site so the test suite never touches the real database.
STORAGE=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --------------------------------------------------------------- the throttles
# Requests allowed from one address per hour. The defaults are in brackets;
# raise one only if a shared office connection is tripping it.
CONTACT_LIMIT=
OFFICE_LIMIT=

# ------------------------------------------------------------------ firebase
# Firebase Authentication for parish administration.
# Create a project at https://console.firebase.google.com, enable Email/Password
# in Authentication -> Sign-in method, and paste your web app credentials here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Primary administrator email (granted owner role on sign-in).
FIREBASE_ADMIN_EMAIL=

# Optional: service account credentials for backend token verification.
# If left blank, token verification uses the project ID and Google's public certificates.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
